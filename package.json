{
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/fetch-soundfonts.js",
    "start": "npx vite",
    "dev": "npx vite",
    "build": "npx vite build",
    "preview": "npx vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "agent:workflow": "node scripts/agent-workflow.js",
    "agent:autonomous": "node scripts/autonomous-agent.js",
    "agent:autonomous:dry": "node scripts/autonomous-agent.js --dry-run",
    "agent:checks": "npm run lint && npm run type-check && npm test && npm run build",
    "agent:validate": "node scripts/validate-agent-setup.js",
    "pre-commit": "node scripts/pre-commit.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.1",
    "@tonejs/midi": "^2.0.28",
    "soundfont-player": "0.7.0",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@vitest/ui": "^4.0.17",
    "eslint": "^9.35.0",
    "happy-dom": "^20.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^4.0.17"
  }
}
